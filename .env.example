# Copy to .env for local testing. Keep secrets and session files out of Git.
PORT=3000
HOST=127.0.0.1
ENV_FILE=./.env

ADMIN_TOKEN=replace-with-a-random-long-secret
AUTO_REPLY_ENABLED=false

# Text understanding
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Audio transcription and voice replies
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=Speak in warm, natural Egyptian Arabic (Masri), as a friendly professional office assistant. Conversational rhythm, clear pronunciation, moderate pace, respectful and reassuring.
# mirror = voice reply for voice input; text reply for text input.
# always = voice replies for every message; never = text only.
VOICE_REPLY_MODE=mirror
VOICE_REPLY_INCLUDE_TEXT=false
MAX_INCOMING_AUDIO_BYTES=12582912
MAX_VOICE_REPLY_CHARS=650
VOICE_BITRATE=32k

MANAGER_NAME=المستشار أحمد
MANAGER_ROLE=مدير متابعة العملاء
MANAGER_PHONE=

MANUAL_TAKEOVER_MINUTES=120
MAX_HISTORY_MESSAGES=12

# Local defaults; Railway Docker image overrides these with /app/persist paths.
DATA_DIR=./data
WWEBJS_AUTH_PATH=./.wwebjs_auth
PUPPETEER_EXECUTABLE_PATH=

# Exact production dashboard origin; no wildcard.
DASHBOARD_ORIGINS=https://media-first-secretary.vercel.app
