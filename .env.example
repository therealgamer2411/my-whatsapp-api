# Copy to .env and fill in your own values. Never commit .env or session files.
PORT=3000
HOST=127.0.0.1
ADMIN_TOKEN=replace-with-a-random-long-secret

# Keep disabled until the QR link, knowledge base and handoff details are tested.
AUTO_REPLY_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MANAGER_NAME=المستشار أحمد
MANAGER_ROLE=مدير متابعة العملاء
MANAGER_PHONE=

MANUAL_TAKEOVER_MINUTES=120
MAX_HISTORY_MESSAGES=12
DATA_DIR=./data
WWEBJS_AUTH_PATH=./.wwebjs_auth
KNOWLEDGE_DIR=./knowledge
